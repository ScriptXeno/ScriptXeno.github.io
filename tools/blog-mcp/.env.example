GEMINI_API_KEY=
GITHUB_OWNER=ScriptXeno
NANOBANANA_MODEL=gemini-3.1-flash-image

# ScriptXeno is a separate GitHub account from the one `gh auth login` is signed into
# (OCEANOFANYTHING has collaborator push-access to ScriptXeno.github.io, but not
# account-level rights to create new repos under ScriptXeno). create_image_repo/
# upload_image need a token generated from the ScriptXeno account itself. Recommended:
# a fine-grained PAT with Resource owner = ScriptXeno, Repository access = All repositories,
# permissions Administration + Contents + Pages all set to Read and write. See
# tools/blog-mcp/README.md for the full walkthrough and rationale.
SCRIPTXENO_GITHUB_TOKEN=
